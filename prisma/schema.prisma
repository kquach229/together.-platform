generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum CardPackSize {
  pack_2
  pack_1
  pack_5
  pack_10
}

enum CardStatus {
  collecting
  delivered
}

enum NotificationType {
  new_signature
  deadline_reminder
  card_delivered
  card_received
}


model User {
  id                   String             @id @default(uuid())
  email                String             @unique
  name                 String
  stripeCustomerId     String?            @unique
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  clerkId              String?            @unique
  lifetimeCardsCreated Int                @default(0)
  cardsRemaining       Int                @default(1)
  cards                Card[]
  cardPurchases        CardPurchase[]
  notifications        Notification[]
  signatures           Signature[]
}

model Card {
  id                  String             @id @default(uuid())
  occasion            String
  recipientName       String
  recipientEmail      String?
  openingMessage      String?
  signingDeadline     DateTime?
  theme               String             @default("warm")
  status              String             @default("collecting")
  creatorId           String
  scheduledDeliveryAt DateTime?
  deliveredAt         DateTime?
  signerCount         Int                @default(0)
  signingToken        String             @unique @default(dbgenerated("encode(gen_random_bytes(16), 'hex'::text)")) @map("signing_token")
  deliveryToken       String             @unique @default(dbgenerated("encode(gen_random_bytes(16), 'hex'::text)")) @map("delivery_token")
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  creatorPhotoUrl     String?
  creator             User               @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  views               CardView[]
  notifications       Notification[]
  signatures          Signature[]
}

model Signature {
  id          String   @id @default(uuid())
  userId      String?
  isHidden    Boolean  @default(false)
  cardId      String
  signerName  String
  signerEmail String?
  message     String
  photoUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  card        Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id])

  @@unique([cardId, userId])
}

model CardView {
  id              String   @id @default(uuid())
  cardId          String
  viewerIp        String?
  viewerUserAgent String?
  viewedAt        DateTime @default(now())
  card            Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  cardId    String?
  type      String
  payload   Json?
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  card      Card?     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StripeEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}

model CardPurchase {
  id                    String             @id @default(uuid())
  userId                String
  packSize              CardPackSize
  cardsAdded            Int
  amountCents           Int
  currency              String             @default("usd")
  stripePaymentIntentId String             @unique
  stripeSessionId       String?            @unique
  createdAt             DateTime           @default(now())
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CardPackPrice {
  id            String       @id @default(uuid())
  packSize      CardPackSize
  cardsIncluded Int
  amountCents   Int
  currency      String       @default("usd")
  stripePriceId String       @unique
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())

  @@unique([packSize, currency])
}

